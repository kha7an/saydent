[Unit]
Description=SayDent MAX notification (%i)
StartLimitIntervalSec=5min
StartLimitBurst=3

[Service]
Type=oneshot
DynamicUser=yes
EnvironmentFile=/etc/saydent/site.env
ExecStart=/usr/bin/python3 /usr/local/lib/saydent-monitor/notify.py %i
TimeoutStartSec=20s
Restart=on-failure
RestartSec=30s
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
